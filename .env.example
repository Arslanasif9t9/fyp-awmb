# Copy this file to .env and fill the values. Never commit .env

# Database: Supabase -> Connect -> "Session pooler" connection string.
# The password must use only letters and numbers (no @ # / symbols).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Auth (use a long random string, 32+ characters)
JWT_SECRET=change_me_to_a_long_random_string_32_chars_or_more
JWT_EXPIRE_MINUTES=720

# AI (free only). Router order: Gemini -> Groq -> Ollama
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_ROUTER_ORDER=gemini,groq,ollama

# App
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Optional: only for the local Docker database in docker-compose.yml (not used now)
POSTGRES_USER=awmb
POSTGRES_PASSWORD=change_me
POSTGRES_DB=awmb
